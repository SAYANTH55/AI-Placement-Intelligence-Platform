# ==========================================
# JobMode Environment Variables Example
# ==========================================

# ── Database ─────────────────────────────
# In development, use SQLite. In production, use PostgreSQL.
DATABASE_URL=sqlite:///ai_placement.db
# DATABASE_URL=postgresql://user:password@localhost:5432/jobmode

# ── Security & Authentication ────────────
# Secret key for session management and signing JWT tokens.
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_super_secret_string
JWT_SECRET=replace_this_with_a_super_secret_string
# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Configuration (Candidate Intelligence) ──
# Primary Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Fallback Key in case of rate limiting
FALLBACK_GEMINI_API_KEY=your_fallback_gemini_api_key_here

# ── Application Configuration ────────────
# Allowed CORS origins for the backend API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Directory where student resumes are uploaded temporarily
UPLOAD_PATH=uploads/

# ── Optional External Services ───────────
# REDIS_URL=redis://localhost:6379/0
