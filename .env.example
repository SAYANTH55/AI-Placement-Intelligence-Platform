# AI Placement Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control (it is gitignored).

# Gemini API key (primary) — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API key (fallback) — optional, used if the primary key fails
FALLBACK_GEMINI_API_KEY=your_fallback_gemini_api_key_here

# Database URL — defaults to SQLite (no config needed for local dev)
# DATABASE_URL=sqlite:///./backend/ai_placement.db
